/* 全部按钮基础样式 */
QPushButton{
    font-family:Microsoft YaHei;
    font-size:18pt;
    font-weight:500;
    border-radius:8px;
    border:none;
    background-color:#424242;
    color:#ffffff;
    min-height:50px;
}
QPushButton:hover{
    background-color:#545454;
}
QPushButton:pressed{
    background-color:#2f2f2f;
}

QPushButton#BtnAdd,#BtnSub,#BtnMul,#BtnDiv{
    background-color:#705c48;
    color:white;
}
QPushButton#BtnAdd:hover,#BtnSub:hover,#BtnMul:hover,#BtnDiv:hover{
    background-color:#836d57;
}
QPushButton#BtnAdd:pressed,#BtnSub:pressed,#BtnMul:pressed,#BtnDiv:pressed{
    background-color:#594a39;
}

QPushButton#BtnCe,#BtnClear{
    background-color:#6b3838;
}
QPushButton#BtnCe:hover,#BtnClear:hover{
    background-color:#804646;
}
QPushButton#BtnCe:pressed,#BtnClear:pressed{
    background-color:#502828;
}

QPushButton#BtnBack{
    background-color:#555555;
}
QPushButton#BtnBack:hover{
    background-color:#666666;
}
QPushButton#BtnBack:pressed{
    background-color:#3d3d3d;
}

QLabel#Display{
